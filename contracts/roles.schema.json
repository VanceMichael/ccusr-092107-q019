{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "角色样例",
  "type": "object",
  "required": ["sample_id", "sides"],
  "properties": {
    "sample_id": { "type": "string", "minLength": 1 },
    "note": { "type": "string" },
    "sides": {
      "type": "object",
      "required": ["product", "review"],
      "properties": {
        "product": { "$ref": "#/$defs/side" },
        "review": { "$ref": "#/$defs/side" }
      },
      "additionalProperties": false
    },
    "fictional_subjects": { "type": "object" }
  },
  "$defs": {
    "side": {
      "type": "object",
      "required": ["responsibility", "members"],
      "properties": {
        "responsibility": { "type": "string", "minLength": 1 },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["user", "name", "role", "duty"],
            "properties": {
              "user": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "name": { "type": "string" },
              "role": { "type": "string" },
              "label": { "type": "string" },
              "duty": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
